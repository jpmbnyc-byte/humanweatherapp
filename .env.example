# Client (safe to expose in Lovable / Vite)
VITE_PURCHASE_URL=https://buy.stripe.com/your-payment-link
VITE_PURCHASE_PRICE=60
VITE_PURCHASE_PRICE_LABEL=Annual access · no monthly plan

# Server secrets (Lovable env — NOT VITE_ prefixed)
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_ANNUAL_AMOUNT_CENTS=6000

# Stripe Payment Link → After payment → Redirect to:
# https://YOUR-DOMAIN/?purchase=success&session_id={CHECKOUT_SESSION_ID}
#
# Stripe Dashboard → Webhooks → endpoint:
# https://YOUR-DOMAIN/api/stripe/webhook
# Events: checkout.session.completed
